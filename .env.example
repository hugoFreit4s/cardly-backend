# Optional — defaults in application.properties already match docker-compose postgres.
# Copy to .env and load in your IDE/run config if you prefer env files over inline vars.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cardly
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

CARDLY_JWT_SECRET=local-dev-jwt-secret-at-least-32-characters-long
CARDLY_JWT_EXPIRATION_SECONDS=3600
CARDLY_GOOGLE_CLIENT_ID=

# Expo web (:8081), Docker web (:3000), Expo Go (:19006)
CARDLY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
